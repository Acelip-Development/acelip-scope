{
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--env=GTK_USE_PORTAL=1"
  ],
  "modules": [
    {
      "buildsystem": "simple",
      "build-commands": [
        "python3 scripts/package.py stage --prefix /app --format Flatpak"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            ".flatpak-builder",
            "var",
            "build",
            "dist",
            "__pycache__"
          ]
        }
      ]
    }
  ]
}
