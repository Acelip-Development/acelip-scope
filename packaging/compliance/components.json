      "license": "FTL AND MIT AND LicenseRef-FreeType-HarfBuzz",
      "obligation": "NOTICE REQUIRED",
      "mapping_evidence": "FT_Library_Version 2.14.3; BDF/PCF modules present; ELF links system zlib and HarfBuzz; exact upstream commit license review"
    },
    {
      "id": "gtk4",
